{
  "name": "deepseek-harness-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness desktop shell (Electron) — boots the bundled dsh web server",
  "author": "DeepSeek Harness",
  "main": "main.js",
  "scripts": {
    "build": "node build.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "ai.deepseek.harness",
    "productName": "DeepSeek Harness",
    "publish": {
      "provider": "github",
      "owner": "1m01m0",
      "repo": "deepseek-harness-desktop",
      "releaseType": "release"
    },
    "files": [
      "main.js"
    ],
    "extraResources": [
      { "from": ".staging/runtime", "to": "runtime" },
      { "from": ".staging/dsh/node_modules", "to": "dsh/node_modules" }
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DeepSeek-Harness-${version}-windows-x64-setup.${ext}"
    },
    "portable": {
      "artifactName": "DeepSeek-Harness-${version}-windows-x64-portable.${ext}"
    },
    "mac": {
      "target": ["zip"]
    },
    "linux": {
      "target": ["AppImage"],
      "artifactName": "DeepSeek-Harness-${version}-linux-x64.${ext}"
    }
  }
}
